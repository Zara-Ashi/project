    },
    {
      "key": "empty_username",
      "username": "",
      "password": "secret_sauce",
      "expected_error": "Epic sadface: Username is required"
    },
    {
      "key": "empty_password",
      "username": "standard_user",
      "password": "",
      "expected_error": "Epic sadface: Password is required"
    },
    {
      "key": "sql_injection",
      "username": "' OR '1'='1",
      "password": "anything",
      "expected_error": "access_denied",
      "notes": "Базовая проверка SQL-инъекции"
    },
    {
      "key": "xss",
      "username": "<script>alert(1)</script>",
      "password": "test",
      "expected_error": "access_denied",
      "notes": "Базовая проверка XSS"
    }
  ],
  "checkout_info": {
    "default": {
      "first_name": "Test",
      "last_name": "User",
      "postal_code": "12345"
    },
    "edge_cases": [
      {
        "key": "empty_first_name",
        "first_name": "",
        "last_name": "User",
